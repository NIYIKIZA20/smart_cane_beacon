/*
 * Smart Cane BEACON – nRF54L15 / BL54L15u board overlay
 * =====================================================================
 * PIN MAP (from BEACON_V1_SCHEMA schematic)
 *
 *  Net    GPIO   Notes
 *  SDA    P0.00  I2C21 sensor bus (BME280 + TMP117)
 *  SCL    P0.01  I2C21 sensor bus
 *  LED1   P1.06  Status LED, 1 kΩ series R1, active HIGH
 *  BTLVL  P1.05  Battery ADC
 *
 * TMP117 NOTE: No Zephyr driver for ti,tmp117 in NCS v3.2.4.
 *   The TMP117 node is declared with compatible = "ti,tmp117" removed
 *   so no device object is generated. sensors.c reads it via raw I2C
 *   using the i2c21 bus device directly (address 0x48).
 * =====================================================================
 */

&pinctrl {
    i2c21_default: i2c21_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 1)>;
            bias-pull-up;
        };
    };
    i2c21_sleep: i2c21_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 1)>;
            low-power-enable;
        };
    };
};

&i2c21 {
    status = "okay";
    pinctrl-0 = <&i2c21_default>;
    pinctrl-1 = <&i2c21_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    /* BME280 — uses Zephyr bosch,bme280 driver (sensor API) */
    bme280_beacon: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
    };

    /*
     * TMP117 — declared as a plain I2C device (no compatible binding).
     * sensors.c reads registers directly via i2c_write_read().
     * Address 0x48 (ADD0 pin → GND on schematic).
     */
    tmp117_raw: tmp117_raw@48 {
        compatible = "vnd,i2c-device";
        reg = <0x48>;
    };
};

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };

/ {
    leds {
        compatible = "gpio-leds";
        beacon_led: beacon_led {
            gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
            label = "BEACON_LED";
        };
    };
};
